#pragma once

#include <Arduino.h>

// ==========================================
// CONFIGURACIÓN DE RED WI-FI (2.4 GHz)
// ==========================================
#define WIFI_SSID       "TU_RED_WIFI"
#define WIFI_PASSWORD   "TU_PASSWORD_WIFI"

// ==========================================
// PINES DE PANTALLA TFT ILI9341 (SPI)
// ==========================================
#define TFT_CS          D8  // GPIO15 - Chip Select
#define TFT_DC          D3  // GPIO0  - Data/Command
#define TFT_RST         D4  // GPIO2  - Reset
#define TFT_ROTATION    3   // 3: Horizontal 320x240

// Control de retroiluminación:
// - Si el pin LED de la TFT está conectado directo a 3V3, pon -1 o déjalo en 3.
// - Si se usa un transistor NPN en el pin RX (GPIO3) del NodeMCU, pon 3.
#define TFT_LED_PIN     3

// ==========================================
// UBICACIÓN Y ZONA HORARIA
// ==========================================
#define LOCATION_NAME   "Santiago"
#define LOCATION_LAT    "-33.4428"
#define LOCATION_LON    "-70.6542"

// Regla POSIX para cambio automático de horario (DST).
// Ejemplos:
// - Chile Continental: "CLT4CLST,M9.1.0/0,M4.1.0/0"
// - España (Madrid):    "CET-1CEST,M3.5.0,M10.5.0/3"
// - Argentina:         "ART3"
// - México (Centro):    "CST6"
#define TIMEZONE_RULE   "CLT4CLST,M9.1.0/0,M4.1.0/0"

// Servidores NTP
#define NTP_SERVER_1    "pool.ntp.org"
#define NTP_SERVER_2    "time.google.com"

// ==========================================
// INTERVALOS DE ACTUALIZACIÓN
// ==========================================
#define CLOCK_REFRESH_INTERVAL_MS    1000UL                 // 1 segundo
#define WEATHER_REFRESH_INTERVAL_MS  (15UL * 60UL * 1000UL) // 15 minutos
#define WEATHER_RETRY_INTERVAL_MS    (60UL * 1000UL)        // 1 minuto si falla
